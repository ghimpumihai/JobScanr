# Copy to .env for production, or to .env.stage for staging. NEVER commit .env files.
# Use the SESSION POOLER url (aws-0-*.pooler.supabase.com) — the direct
# db.*.supabase.co host is IPv6-only and unreachable from GitHub Actions.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Staging environment (.env.stage):
# Set up a second free Supabase project in .env.stage so experiments
# never touch production state. Activate with the --staging flag.
# Email delivery (the channel you actually read). Example for Gmail:
# create an App Password at myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=<app-password>
DIGEST_EMAIL=you@gmail.com

# AI-assisted ATS link fixing (free via console.groq.com/keys — no credit card required)
GROQ_API_KEY=gsk_...
# Optional override (default: openai/gpt-oss-120b or qwen/qwen3.8-27b)
# GROQ_MODEL=openai/gpt-oss-120b
# The same key and model draft open-ended answers in remote fill plans for users who opt in (#59); without
# GROQ_MODEL, drafts use openai/gpt-oss-120b. Setting GROQ_MODEL changes both.

# Remote-browser apply spike (#129). Off unless REMOTE_APPLY_ENABLED=true; only the listed users.ids get it.
# REMOTE_APPLY_ENABLED=false
# REMOTE_APPLY_USER_IDS=3,7
# Which service runs new sessions: browserbase (default) or cloudflare. Each session keeps the one that made it.
# REMOTE_APPLY_PROVIDER=browserbase
# BROWSERBASE_API_KEY=bb_live_...
# BROWSERBASE_PROJECT_ID=<project id>
# Cloudflare Browser Run: account ID, and an API token with the Browser Rendering - Edit permission.
# CLOUDFLARE_ACCOUNT_ID=<account id>
# CLOUDFLARE_BROWSER_RUN_TOKEN=<api token>
# Set to true only if your Browserbase plan cannot turn session recording off (tell pilot users).
# REMOTE_APPLY_ALLOW_RECORDING=false
