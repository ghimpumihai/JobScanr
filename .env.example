# Copy to .env and fill in. NEVER commit .env.
# Use the SESSION POOLER url (aws-0-*.pooler.supabase.com) — the direct
# db.*.supabase.co host is IPv6-only and unreachable from GitHub Actions.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
FCM_CREDENTIALS_PATH=fcm-service-account.json
